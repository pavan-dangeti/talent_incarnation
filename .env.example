# Copy to .env.local and fill in your own values. Never commit real secrets.

# Auth.js (Phase 1). Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string (Phase 1)
DATABASE_URL=

# Gemini (Phase 3). Model names are configurable; set the ones you want to use.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=
