# Copy to .env.local and fill in your own values. Never commit real secrets.

# Auth.js (Phase 1). Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string (Phase 1)
DATABASE_URL=

# Gemini (Phase 3). Chat stays disabled until both the key and the chat model are set.
# Choose a current model id from https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
